<div class="row mt-3 fixed-bottom footer-color" style="z-index:10; display:none;" id="div-footer">
    <div class="col-12 text-end px-4">
        <button type="button" id="btnFooterApprove" class="btn btn-info waves-effect waves-light m-1" onclick="onApproveClick()"><i class="bi bi-check2-circle"></i> Approve</button>
        <button type="button" id="btnFooterRefresh" class="btn btn-secondary waves-effect waves-light m-1" onclick="onRefreshClick()"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
        <button type="button" id="btnFooterDelete" style="display:none;" class="btn btn-danger waves-effect waves-light m-1"><i class="bi bi-trash-fill"></i> Delete</button>
        <button type="button" id="btnFooterRecalculate" class="btn  waves-effect waves-light m-1" style="background:white;"><i class="bi bi-calculator-fill"></i> Recalculate</button>
        <button type="button" id="btnFooterSave" class="btn btn-success waves-effect waves-light m-1">
            <i class="bi bi-save"></i> Save
        </button>
        <button type="button" id="btnFooterSaveNew" style="display:none;" class="btn btn-info waves-effect waves-light m-1">
            <i class="bi bi-clipboard-plus-fill"></i> Save And New
        </button>
        <button type="button" id="btnFooterCancel" class="btn btn-danger waves-effect waves-light m-1"><i class="bi bi-x-circle"></i> Cancel</button>
    </div>
</div>
