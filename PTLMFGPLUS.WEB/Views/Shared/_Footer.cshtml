<div class="app-action-footer fixed-bottom footer-color"
     id="div-footer"
     role="toolbar"
     aria-label="Page actions"
     aria-hidden="true"
     style="display: none;">
    <div class="app-action-footer-buttons">
        <button type="button"
                id="btnFooterApprove"
                class="btn btn-info waves-effect waves-light ui-size-xs"
                style="display: none;"
                onclick="onApproveClick()">
            <i class="bi bi-check2-circle" aria-hidden="true"></i>
            Approve
        </button>
        <button type="button"
                id="btnFooterRefresh"
                class="btn btn-outline-secondary waves-effect waves-light ui-size-xs"
                onclick="onRefreshClick()">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
            Refresh
        </button>
        <button type="button"
                id="btnFooterDelete"
                class="btn btn-danger waves-effect waves-light ui-size-xs"
                style="display: none;">
            <i class="bi bi-trash-fill" aria-hidden="true"></i>
            Delete
        </button>
        <button type="button"
                id="btnFooterRecalculate"
                class="btn btn-outline-secondary waves-effect waves-light ui-size-xs">
            <i class="bi bi-calculator-fill" aria-hidden="true"></i>
            Recalculate
        </button>
        <button type="button"
                id="btnFooterSave"
                class="btn btn-success waves-effect waves-light ui-size-xs">
            <i class="bi bi-save" aria-hidden="true"></i>
            Save
        </button>
        <button type="button"
                id="btnFooterSaveNew"
                class="btn btn-info waves-effect waves-light ui-size-xs"
                style="display: none;">
            <i class="bi bi-clipboard-plus-fill" aria-hidden="true"></i>
            Save and new
        </button>
        <button type="button"
                id="btnFooterCancel"
                class="btn btn-outline-danger waves-effect waves-light ui-size-xs">
            <i class="bi bi-x-circle" aria-hidden="true"></i>
            Cancel
        </button>
    </div>
</div>
