@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@{
    string pageTitle = ViewData["Title"]?.ToString() ?? "Workspace";
    string companyName = User.FindFirst("CompanyName")?.Value ?? "PTL Manufacturing Plus";
    string companyShortName = User.FindFirst("CompanyShortName")?.Value ?? companyName;
    string companyCode = User.FindFirst("Comcod")?.Value ?? string.Empty;
    string userName = User.FindFirst("UserShortName")?.Value
        ?? User.Identity?.Name
        ?? "User";
    string userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
    string sessionId = User.FindFirst("SessionId")?.Value ?? string.Empty;
    string companyLogoFile = $"logo{companyCode}.PNG";
    string companyLogoPath = System.IO.Path.Combine(WebHostEnvironment.WebRootPath, "Images", "Company_Logo", companyLogoFile);
    string companyLogoUrl = System.IO.File.Exists(companyLogoPath)
        ? Url.Content($"~/Images/Company_Logo/{companyLogoFile}")
        : Url.Content("~/Images/Company_Logo/logo1.PNG");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@pageTitle | @companyShortName</title>
    <script>
        (function () {
            const savedTheme = localStorage.getItem("theme") || "light";
            document.documentElement.setAttribute("data-theme", savedTheme);
        })();
    </script>

    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/offline/bootstrap-5.0.2-dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/offline/bootstrap-icons-1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/offline/css/select2.min.css" />
    <link rel="stylesheet" href="~/vendor/bootstrap-datepicker/css/bootstrap-datepicker.min.css" />
    <link rel="stylesheet" href="~/offline/dataTables/css/dataTables.bootstrap4.min.css" />
    <link rel="stylesheet" href="~/offline/dataTables/css/responsive.bootstrap4.min.css" />
    <link rel="stylesheet" href="~/offline/dataTables/css/buttons.bootstrap4.min.css" />
    <link rel="stylesheet" href="~/vendor/sweetalert2/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/common_design/enterprise-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/common_design/interface-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/common_design/transaction-entry.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/common_design/admin-shell.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-page">
    <div class="admin-shell">
        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-brand">
                <a class="sidebar-brand-mark"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="DashboardIndex"
                   aria-label="Open dashboard">
                    <img src="@companyLogoUrl"
                         alt="@companyShortName logo" />
                </a>
            </div>

            <div class="sidebar-content">
                <p class="sidebar-section-label">
                    Operations
                </p>
                @await Component.InvokeAsync("AdminNavigation")
            </div>

            <div class="sidebar-footer">
                <div class="sidebar-session">
                    <i class="bi bi-shield-check sidebar-session-icon" aria-hidden="true"></i>
                    <div class="sidebar-session-copy">
                        <strong>Secure session</strong>
                        <span>@(string.IsNullOrWhiteSpace(sessionId) ? "Authenticated" : $"ID {sessionId}")</span>
                    </div>
                </div>
            </div>
        </aside>

        <div class="mobile-sidebar-backdrop" id="sidebarBackdrop"></div>

        <div class="app-main">
            <header class="app-topbar">
                <button class="topbar-action"
                        id="sidebarToggle"
                        type="button"
                        aria-label="Toggle navigation">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>

                <div class="topbar-company">
                    <h1>@pageTitle</h1>
                    @* <p>
                        @companyName
                        @if (!string.IsNullOrWhiteSpace(companyCode))
                        {
                            <span> · @companyCode</span>
                        }
                    </p> *@
                </div>

                <div class="topbar-tools">
                    <div class="report-toolbar" aria-label="Report output">
                        <label class="visually-hidden" for="DDPrintOpt">
                            Report format
                        </label>
                        <select class="form-select form-select-sm no-select2"
                                id="DDPrintOpt"
                                name="DDPrintOpt"
                                aria-label="Report format">
                            <option value="PDF" selected>PDF</option>
                            <option value="HTML">HTML</option>
                            <option value="WORD">Word</option>
                            <option value="EXCEL">Excel</option>
                        </select>
                        <button class="btn btn-sm report-print-button"
                                id="lnkPrint"
                                type="button"
                                title="Print or export report"
                                aria-label="Print or export report">
                            <i class="bi bi-printer" aria-hidden="true"></i>
                        </button>
                    </div>

                    <button class="topbar-action"
                            id="themeToggle"
                            type="button"
                            aria-label="Use dark mode">
                        <i class="bi bi-moon-stars-fill" aria-hidden="true"></i>
                    </button>

                    <div class="profile-dropdown">
                        <button class="profile-button"
                                id="profileButton"
                                type="button"
                                aria-haspopup="true"
                                aria-expanded="false">
                            <span class="profile-avatar">
                                <i class="bi bi-person" aria-hidden="true"></i>
                            </span>
                            <span class="profile-copy">
                                <strong>@userName</strong>
                                @* <span>@userRole</span> *@
                            </span>
                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                        </button>

                        <div class="profile-menu" id="profileMenu">
                            <div class="profile-menu-header">
                                <strong>@userName</strong>
                                @* <span>@userRole · @companyShortName</span> *@
                            </div>
                            <form asp-area=""
                                  asp-controller="Home"
                                  asp-action="Logout"
                                  method="post">
                                <button class="profile-menu-action logout" type="submit">
                                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                    Sign out
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <main class="app-content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </main>

            <footer class="app-footer">
                <span>© @DateTime.Now.Year Pinovation Tech Ltd. · PTL Manufacturing Plus</span>
            </footer>
        </div>

        <partial name="_Footer" />
    </div>

    <script>
        var appPath = '@Url.Content("~/")';
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/offline/bootstrap-5.0.2-dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/offline/js/select2.min.js"></script>
    <script src="~/vendor/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
    <script src="~/offline/dataTables/js/jquery.dataTables.min.js"></script>
    <script src="~/offline/dataTables/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/offline/dataTables/js/dataTables.responsive.min.js"></script>
    <script src="~/offline/dataTables/js/responsive.bootstrap4.min.js"></script>
    <script src="~/offline/dataTables/js/dataTables.buttons.min.js"></script>
    <script src="~/offline/dataTables/js/buttons.bootstrap4.min.js"></script>
    <script src="~/offline/js/jszip.min.js"></script>
    <script src="~/offline/dataTables/js/buttons.html5.min.js"></script>
    <script src="~/offline/dataTables/js/buttons.print.min.js"></script>
    <script src="~/offline/js/busy-load.min.js"></script>
    <script src="~/vendor/sweetalert2/dist/sweetalert2.all.min.js"></script>
    <script src="~/offline/js/toastr.min.js"></script>
    <script src="~/js/common/site.js" asp-append-version="true"></script>
    <script src="~/js/common/FetchHelper.js" asp-append-version="true"></script>
    <script src="~/js/common/Helper.js" asp-append-version="true"></script>
    <script src="~/js/common/NotifyHelper.js" asp-append-version="true"></script>
    <script src="~/js/common/enterprise-ui.js" asp-append-version="true"></script>
    <script src="~/js/common/admin-shell.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
