@model PTLMFGPLUS.ENTITY.EClass_Login.Login_VM
@using static PTLMFGPLUS.ENTITY.EClass_Login
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Sign in";
    var companies = ViewBag.Companies as IEnumerable<CompanyInfo> ?? Enumerable.Empty<CompanyInfo>();
}

<main class="login-shell">
    <section class="login-identity" aria-labelledby="product-heading">
        <div class="login-identity-content">
            <img class="login-product-mark"
                 src="~/Images/logo_svg.svg"
                 alt="PTL Manufacturing Plus" />
            <p class="login-eyebrow">
                Enterprise Manufacturing ERP
            </p>
            <h2 class="login-title" id="product-heading">
                Control the factory floor from one trusted workspace.
            </h2>
            <p class="login-summary">
                Production, inventory, procurement, accounts, and management reporting—connected through one secure operating system.
            </p>
        </div>
    </section>

    <section class="login-form-panel">
        <div class="login-card">
            <header class="login-card-header">
                <div>
                    <h1>
                        Welcome back
                    </h1>
                    <p class="login-card-subtitle">
                        Sign in to continue to your company workspace.
                    </p>
                </div>
                <button class="theme-toggle"
                        id="themeToggle"
                        type="button"
                        aria-label="Use dark mode">
                    <i class="bi bi-moon-stars-fill" aria-hidden="true"></i>
                </button>
            </header>

            <form asp-action="Index"
                  asp-controller="Home"
                  method="post"
                  id="loginForm"
                  novalidate>
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger py-2"
                     role="alert">
                </div>

                <div class="ui-field">
                    <label class="ui-label ui-label-required" for="ddlcomp">
                        Company
                    </label>
                    <select class="form-select ui-select"
                            id="ddlcomp"
                            asp-for="comcod"
                            data-placeholder="Select a company"
                            autocomplete="organization"
                            required>
                        <option value="">
                            Select a company
                        </option>
                        @foreach (var company in companies)
                        {
                            <option value="@company.comcod">
                                @company.comname
                            </option>
                        }
                    </select>
                    <span asp-validation-for="comcod" class="ui-validation"></span>
                </div>

                <div class="ui-field">
                    <label class="ui-label ui-label-required" for="username">
                        User name
                    </label>
                    <div class="input-group login-input-group">
                        <span class="input-group-text">
                            <i class="bi bi-person" aria-hidden="true"></i>
                        </span>
                        <input class="form-control ui-control"
                               id="username"
                               type="text"
                               asp-for="username"
                               placeholder="Enter your user name"
                               autocomplete="username"
                               autocapitalize="none"
                               required />
                    </div>
                    <span asp-validation-for="username" class="ui-validation"></span>
                </div>

                <div class="ui-field">
                    <label class="ui-label ui-label-required" for="password">
                        Password
                    </label>
                    <div class="input-group login-input-group">
                        <span class="input-group-text">
                            <i class="bi bi-shield-lock" aria-hidden="true"></i>
                        </span>
                        <input class="form-control ui-control"
                               id="password"
                               type="password"
                               asp-for="userpass"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               required />
                        <button class="btn password-toggle"
                                id="passwordToggle"
                                type="button"
                                aria-label="Show password">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="userpass" class="ui-validation"></span>
                </div>

                <button class="btn ui-btn-primary login-submit w-100"
                        id="loginSubmit"
                        type="submit">
                    Sign in securely
                </button>
            </form>

            <p class="login-footer">
                Authorized enterprise access only · PTL Manufacturing Plus
            </p>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
