@model PTLMFGPLUS.ENTITY.EClass_Login.Login_VM
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Home Page";
}

@section Styles {
    
}

<div class="account-pages mt-5 mb-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 col-xl-4">
                <div class="card bg-pattern">

                    <div class="card-body p-4">

                        <div class="text-center w-75 m-auto">
                            <div class="auth-logo">
                                <a href="index.html" class="logo logo-dark text-center">
                                    <span class="logo-lg">
                                        <img src="~/Images/logo_svg.svg" alt="" height="35">
                                    </span>
                                </a>

                                <a href="index.html" class="logo logo-light text-center">
                                    <span class="logo-lg">
                                        <img src="~/Images/logo_svg.svg" alt="" height="35">
                                    </span>
                                </a>
                            </div>
                            <p class="text-muted mb-4 mt-3">Enter your user and password.</p>
                        </div>

                        <form asp-action="Index" asp-controller="Home">
                            <div class="mb-3">
                                <label for="ddlcomp" class="form-label">Company</label>
                                <select class="form-select" id="ddlcomp" asp-for="comcod">
                                    @foreach (var c in ViewBag.Companies)
                                    {
                                        <option value="@c.comcod">
                                            @c.comname
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="username" class="form-label">Email address</label>
                                <input type="text" id="username" class="form-control" placeholder="User Name" autocomplete="off" asp-for="username">
                            </div>

                            <div class="mb-3">
                                <label for="password" class="form-label">Password</label>
                                <div class="input-group input-group-merge">
                                    <input type="password" id="password" class="form-control" placeholder="Enter your password" asp-for="userpass">
                                    <div class="input-group-text" data-password="false">
                                        <span class="password-eye"></span>
                                    </div>
                                </div>
                            </div>


                            <div class="text-center d-grid">
                                <button class="btn btn-primary" type="submit"> Log In </button>
                            </div>

                        </form>

                    </div> <!-- end card-body -->
                </div>
                <!-- end card -->

                <div class="row mt-3">
                    <div class="col-12 text-center">
                        <p> <a href="auth-recoverpw.html" class="text-white-50 ms-1">Forgot your password?</a></p>
                        <p class="text-white-50">Don't have an account? <a href="auth-register.html" class="text-white ms-1"><b>Sign Up</b></a></p>
                    </div> <!-- end col -->
                </div>
                <!-- end row -->

            </div> <!-- end col -->
        </div>
        <!-- end row -->
    </div>
    <!-- end container -->
</div>




@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/loginJs.js" asp-append-version="true"></script>
    <script>
        GetComp('@Url.Content("~/js/")');

    </script>
    @if (ViewBag.JavascriptFunction != null)
    {
        <script type="text/javascript">
            @Html.Raw(ViewBag.JavascriptFunction)
        </script>

    }

}
