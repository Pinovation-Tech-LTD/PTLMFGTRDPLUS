@using PTLMFGPLUS.ENTITY
@model List<EUserModule>

<div class="permissions-container container mt-4">
    
    <div class="d-flex flex-wrap align-items-center mb-3 gap-3">
        <div class="d-flex align-items-center gap-2">
            <label for="pageSize" class="form-label mb-0">Page Size:</label>
            <select id="pageSize" class="form-select form-select-sm" style="width: auto;">
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="300" selected>300</option>
            </select>
            <div class="form-check ms-3">
                <input class="form-check-input" type="checkbox" id="showAll">
                <label class="form-check-label" for="showAll">Show All</label>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <label for="moduleSelect" class="form-label mb-0">Module Name:</label>
            <select id="moduleSelect" name="module" class="form-select form-select-sm" style="width: 200px;">
                @foreach (var item in Model)
                {
                    <option value="@item.moduleid">@item.modulename</option>
                }
            </select>
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-bordered table-hover align-middle mb-0">
            <thead class="table-dark text-white">
                <tr>
                    <th>SL</th>
                    <th>Description</th>
                    <th>Alias</th>
                    <th>
                        Permission
                        <div class="form-check d-inline ms-2">
                            <input class="form-check-input" type="checkbox" id="checkAll">
                        </div>
                    </th>
                </tr>
            </thead>
            <tbody id="permissionsBody">
              
            </tbody>
        </table>
    </div>

</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
    
    $('#checkAll').on('change', function () {
        $('.permission-checkbox').prop('checked', $(this).is(':checked'));
    });


        $(document).ready(function() {
        $('#moduleSelect').change(function() {
            var moduleid = $(this).val();

            if (!moduleid) {
                $('#permissionsBody').html('');
                return;
            }

            $.ajax({
                url: '@Url.Action("GetModuleData")',
                type: 'GET',
                data: { moduleid: moduleid },
                success: function(res) {
                    if(res.success && res.data.length > 0) {
                        var html = '';

                   
                        res.data.forEach(function(page) {
                           
                            html += '<tr>';
                            html += '<td>' + page.category + '</td>';
                            html += '<td>' + page.pageName + '</td>';
                            html += '<td>' + '' + '</td>';
                            html += '<td><input type="checkbox" class="form-check-input permission-checkbox"></td>';
                            html += '</tr>';
                        });

                        $('#permissionsBody').html(html);
                    } else {
                        $('#permissionsBody').html('<tr><td colspan="2" class="text-danger">No pages found.</td></tr>');
                    }
                },
                error: function() {
                    $('#permissionsBody').html('<tr><td colspan="2" class="text-danger">Error fetching data.</td></tr>');
                }
            });
        });
    });



</script>