@{
    ViewData["Title"] = "Company Page Permission";
    List<EUserModule> moduleList = ViewBag.ddlmodule as List<EUserModule> ?? new List<EUserModule>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/controlpanel/company-permission.css" asp-append-version="true" />
}

<div class="permission-page">
    @Html.AntiForgeryToken()
    <div class="card permission-card">
        <div class="card-body">
            <div class="permission-toolbar">
                <div class="permission-module-filter">
                    <label for="ddlmodule" class="form-label">Module</label>
                    <select class="form-select ui-size-xm" id="ddlmodule" data-placeholder="Select module">
                        @foreach (EUserModule item in moduleList)
                        {
                            <option value="@item.moduleid" selected="@(item.moduleid == "AA")">@item.modulename</option>
                        }
                    </select>
                </div>
                <div class="permission-switch">
                    <input class="form-check-input" type="checkbox" id="showAll" />
                    <label class="form-check-label" for="showAll">Show all available pages</label>
                </div>
                <div class="permission-summary" aria-live="polite">
                    <span><strong id="availableCount">0</strong> available</span>
                    <span><strong id="selectedCount">0</strong> permitted</span>
                </div>
                <div class="permission-actions">
                    <a asp-area="ControlPanel" asp-controller="UserPerm" asp-action="UserPermIndex" class="btn btn-outline-primary ui-size-xm">
                        <i class="bi bi-people me-1"></i>User permission
                    </a>
                </div>
            </div>

            <div class="table-responsive permission-table-wrap">
                <table id="tblpageperCheck" class="table table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th class="serial-column">#</th>
                            <th>Module / Section</th>
                            <th>Page description</th>
                            <th>Alias</th>
                            <th class="permission-column">
                                <label for="chktblall">Permission</label>
                                <input type="checkbox" id="chktblall" class="form-check-input" aria-label="Select all pages" />
                            </th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/j_controlpanel/compermission.js" asp-append-version="true"></script>
}
