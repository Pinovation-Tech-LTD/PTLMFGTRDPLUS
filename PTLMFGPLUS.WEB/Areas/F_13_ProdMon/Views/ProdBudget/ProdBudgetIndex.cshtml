@{
    ViewData["Title"] = "Production Budget";
    var companyCode = User.FindFirst("Comcod")?.Value;
    var hasImeiControls = companyCode is "8401" or "8421";
    var hasChassisControls = companyCode == "8421";
}

<div class="enterprise-entry-page prod-budget-page">
    <div class="card entry-header-card">
        <div class="card-body">
            <div class="entry-form-grid">
                <div class="entry-field entry-span-2">
                    <label for="txtbgddate" class="form-label">Budget Date</label>
                    <input id="txtbgddate" type="text" class="form-control form-control-sm datepicker datepicker-current prod-budget-date" autocomplete="off" />
                </div>
                <div class="entry-field entry-span-2">
                    <label for="txtBpn" class="form-label">Budget No.</label>
                    <input id="txtBpn" type="text" class="form-control form-control-sm" readonly />
                </div>
                <div class="entry-field entry-span-2">
                    <label for="txtfrmdate" class="form-label">From</label>
                    <input id="txtfrmdate" type="text" class="form-control form-control-sm datepicker datepicker-current prod-budget-date" autocomplete="off" />
                </div>
                <div class="entry-field entry-span-2">
                    <label for="txttodate" class="form-label">To</label>
                    <input id="txttodate" type="text" class="form-control form-control-sm datepicker datepicker-current prod-budget-date" autocomplete="off" />
                </div>
                <div class="entry-field entry-span-3" id="previousBudget">
                    <label for="ddlPreProlist" class="form-label">Previous Budget</label>
                    <select id="ddlPreProlist" class="form-select form-select-sm">
                        <option value="">New budget</option>
                    </select>
                </div>
                <div class="entry-field-actions entry-span-1">
                    <button id="btnOk" type="button" class="btn btn-primary ui-size-xm w-100">
                        <i class="bi bi-folder2-open" aria-hidden="true">
                        </i>
                        Open
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="budgetWorkspace" class="entry-panel" style="display:none">
        <ul class="nav entry-tabs" id="budgetTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link" data-budget-tab="products" type="button">
                    <i class="bi bi-box-seam me-1">
                    </i>Product Selection
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-budget-tab="materials" type="button">
                    <i class="bi bi-tools me-1">
                    </i>Material Input
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-budget-tab="reports" type="button">
                    <i class="bi bi-file-earmark-bar-graph me-1">
                    </i>Reports
                </button>
            </li>
        </ul>

        <section id="productsPanel" class="budget-panel entry-panel" style="display:none">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-3">
                    <div class="row g-2 align-items-end product-toolbar">
                        <div class="col-xl-2 col-lg-3 col-md-5">
                            <label for="ddlGroupList" class="form-label">Group</label>
                            <select id="ddlGroupList" class="form-select form-select-sm">
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-5">
                            <label for="ddlProductList" class="form-label">Product</label>
                            <select id="ddlProductList" class="form-select form-select-sm">
                            </select>
                        </div>
                        <div class="col-auto">
                            <button id="btnSelect" type="button" class="btn btn-primary btn-sm">Select</button>
                        </div>
                        <div class="col-auto">
                            <button id="btnSelectAll" type="button" class="btn btn-primary btn-sm">Select All</button>
                        </div>
                        @if (hasImeiControls)
                        {
                            <div class="col-xl-2 col-lg-3 col-md-5 ms-xl-auto">
                                <label for="imeiFile" class="form-label">Excel :</label>
                                <input id="imeiFile" type="file" accept=".xlsx,.xlsm" class="form-control form-control-sm" />
                            </div>
                            <div class="col-auto">
                                <button id="btnImeiCounter" type="button" class="btn btn-danger btn-sm" disabled>COUNTER</button>
                            </div>
                            <div class="col-auto">
                                <a id="btnImeiFormat" class="btn btn-success btn-sm" href="@Url.Action("DownloadImeiFormat", "ProdBudget", new { area = "F_13_ProdMon" })">
                                    <i class="bi bi-download me-1">
                                    </i>Format
                                </a>
                            </div>
                            <div class="col-auto">
                                <button id="btnRemoveImei" type="button" class="btn btn-warning btn-sm">
                                    <i class="bi bi-arrow-counterclockwise me-1">
                                    </i>Reverse
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="entry-split-grid">
                <div class="col-md-7">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-2" id="productBudgetDiv">
                            <div class="table-responsive entry-native-table-shell">
                                <table id="productBudgetTable" class="table table-sm table-striped table-hover table-bordered align-middle enterprise-native-table budget-table product-budget-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Sl</th>
                                            <th>
                                            </th>
                                            <th>Group</th>
                                            <th>Description of Item</th>
                                            <th>Unit</th>
                                            <th>Closing Stock</th>
                                            <th>Budgeted Qty</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th colspan="5" class="text-end">Total</th>
                                            <th>
                                            </th>
                                            <th id="bgdwqtyTotal" class="text-end">0</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button id="btnPrintBudget" type="button" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-printer me-1">
                                    </i>Print
                                </button>
                                <button id="btnTotal" type="button" class="btn btn-outline-primary btn-sm">Recalculate</button>
                                <button id="btnFinalUpdate" type="button" class="btn btn-success btn-sm">
                                    <i class="bi bi-save me-1">
                                    </i>Save Budget
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">Batch Name</span>
                        <input id="txtBatchName" class="form-control" maxlength="150" />
                    </div>
                    @if (hasChassisControls)
                    {
                        <div class="d-flex gap-2 mt-3">
                            <button id="btnFreeChassis" type="button" class="btn btn-outline-info btn-sm">Add Chassis</button>
                            <button id="btnAssignedChassis" type="button" class="btn btn-outline-secondary btn-sm">View Chassis</button>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section id="materialsPanel" class="budget-panel entry-panel" style="display:none">
            <div class="entry-split-grid">
                <div class="col-md-9">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header fw-semibold">Budgeted Resources</div>
                        <div class="card-body p-2">
                            <div class="table-responsive entry-native-table-shell">
                                <table id="resourceTable" class="table table-sm table-striped table-hover align-middle enterprise-native-table budget-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Product Code</th>
                                            <th>Description of Item</th>
                                            <th>Specification</th>
                                            <th>Unit</th>
                                            <th>Stock Qty</th>
                                            <th>Qty</th>
                                            <th>Rate</th>
                                            <th>Budgeted Amount</th>
                                            <th>Select</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th colspan="8" class="text-end">Total</th>
                                            <th id="resourceAmountTotal" class="text-end">0.000</th>
                                            <th>
                                            </th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="d-flex flex-wrap justify-content-end gap-2 mt-3">
                                <button id="btnResourceTotal" type="button" class="btn btn-outline-primary btn-sm">Recalculate</button>
                                <button id="btnSaveResources" type="button" class="btn btn-success btn-sm">
                                    <i class="bi bi-save me-1">
                                    </i>Save Material Input
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header fw-semibold">Production Process</div>
                        <div class="card-body p-2">
                            <div class="table-responsive entry-native-table-shell">
                                <table id="processTable" class="table table-sm table-striped align-middle enterprise-native-table budget-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Select</th>
                                            <th>Process</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                            
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="reportsPanel" class="budget-panel entry-panel" style="display:none">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3">
                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-md-5">
                            <label for="ddlReportProduct" class="form-label">Product</label>
                            <select id="ddlReportProduct" class="form-select form-select-sm">
                            </select>
                        </div>
                        <div class="col-auto">
                            <button id="btnShowReport" type="button" class="btn btn-primary btn-sm">Show</button>
                        </div>
                        <div class="col-auto">
                            <button id="btnPrintReport" type="button" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-printer me-1">
                                </i>Print
                            </button>
                        </div>
                        <div class="col-auto">
                            <button id="btnExportReport" type="button" class="btn btn-outline-success btn-sm">
                                <i class="bi bi-file-earmark-excel me-1">
                                </i>Export
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive entry-native-table-shell">
                        <table id="budgetReportTable" class="table table-sm table-striped table-hover align-middle enterprise-native-table budget-table mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Description of Item</th>
                                    <th>Specification</th>
                                    <th>Unit</th>
                                    <th>Budgeted Qty</th>
                                    <th>Rate</th>
                                    <th>Budgeted Amount</th>
                                    <th>%</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@if (hasChassisControls)
{
    <div class="modal fade" id="engineCodeModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Chassis and Engine Codes</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal">
                    </button>
                </div>
                <div class="modal-body">
                    <div class="table-responsive entry-native-table-shell">
                        <table id="engineCodeTable" class="table table-sm table-striped enterprise-native-table budget-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Item Name</th>
                                    <th>Chassis</th>
                                    <th>Engine</th>
                                    <th>SL</th>
                                    <th>Qty</th>
                                    <th>Select</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="5" class="text-end">Total</th>
                                    <th id="engineQtyTotal">0</th>
                                    <th>
                                    </th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button id="btnAssignEngineCodes" type="button" class="btn btn-success">Assign Selected</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/j_13_prodmon/jprodbudget.js" asp-append-version="true">
    </script>
}
