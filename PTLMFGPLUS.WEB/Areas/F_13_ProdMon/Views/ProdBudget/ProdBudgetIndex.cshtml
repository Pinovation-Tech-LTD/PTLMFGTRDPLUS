<div class="card border-0 shadow-lg rounded-4 mb-2">
    <div class="card-body p-3 rounded-4">

        <div class="row g-2 align-items-end">
            <div class="col-md-1">
                <label for="txtbgddate" class="form-label fw-semibold">
                    Bdg Date
                </label>
                <input id="txtbgddate" type="text"
                       class="form-control form-control-sm datepicker datepicker-current rounded-1 shadow-sm px-0" />
            </div>
            <div class="col-md-2">
                <label for="txtBpn" class="form-label fw-bold fs-6 mb-2">
                    Budget No.
                </label>
                <input id="txtBpn" type="text" class="form-control form-control-sm shadow-sm border-0 rounded-3" placeholder="PBM-00001" readonly />
            </div>
            <div class="col-md-1">
                <label for="txtfrmdate" class="form-label fw-semibold">
                    From
                </label>
                <input id="txtfrmdate" type="text"
                       class="form-control form-control-sm datepicker datepicker-current rounded-1 shadow-sm  px-0" />
            </div>

            <div class="col-md-1">
                <label for="txttodate" class="form-label fw-semibold">
                    To
                </label>
                <input id="txttodate" type="text"
                       class="form-control form-control-sm datepicker datepicker-current rounded-1 shadow-sm  px-0" />
            </div>

            <div class="col-md-1">
                <button id="btnOk" class="btn btn-primary btn-sm">
                    Ok
                </button>
            </div>
            <div class="col-md-2" id="previousBudget" style="display:inline-block;">
                <label id="lblPrePBNo" class="form-label fw-bold text-primary fs-6 mb-2 search-label">
                    Pre Budget
                </label>
                <select id="ddlPreProlist" class="form-select form-select-sm shadow-sm border-0 rounded-3">
                    <option value="">Select Previous...</option>
                </select>
            </div>

            <div class="form-group col-md-5" id="rbtnList">
                <div class="rbtnList1 col-10 form-control form-control-sm mt-3" style="display:none;">
                    <label style="margin-right: 15px;">
                        <input type="radio" name="rbtnlist" value="0">
                        Product Selection
                    </label>

                    <label style="margin-right: 15px;">
                        <input type="radio" name="rbtnlist" value="1">
                        Material Input
                    </label>

                    <label style="margin-right: 15px;">
                        <input type="radio" name="rbtnlist" value="2">
                        Reports
                    </label>
                </div>
            </div>
        </div>
        <div class="row g-3 align-items-end" id="ProductSelection" style="display:none">

            <div class="col-md-3" id="ProductList">
                <label id="lblProductList" class="form-label fw-semibold fs-6 mb-2 search-label">
                    Product
                </label>
                <select id="ddlProductList" class="form-select form-select-sm shadow-sm rounded-3">
                    <option value="">Select Product...</option>
                </select>
            </div>

            <div class="col-md-1">
                <button id="btnSelect" class="btn btn-primary btn-sm w-100 mt-2 rounded-3">
                    Select
                </button>
            </div>

            <div class="col-md-1">
                <button id="btnSelectAll" class="btn btn-outline-primary btn-sm w-100 mt-2 rounded-3">
                    Select All
                </button>
            </div>

            <div class="col-md-3" id="Excefile">
                <label id="lblExcefile" class="form-label fw-semibold fs-6 mb-2">
                    Excel
                </label>
                <input type="file" class="form-control form-control-sm shadow-sm rounded-3" />
            </div>

            <div class="col-md-4" id="BatchName">
                <label id="lblBatchName" class="form-label fw-semibold fs-6 mb-2">
                    Batch Name
                </label>
                <input id="txtBatchName" type="text" class="form-control form-control-sm shadow-sm rounded-3" />
            </div>
        </div>
        <div class="pm-table-card table-section p-3" style="width:500px;">
            <div id="tableProdBudget"
                 class="table-responsive w-100"
                 style="display:none;">

                <table class="table table-hover align-middle mb-0 fit-grid">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Group</th>
                            <th>Description of Item</th>
                            <th>Unit</th>
                            <th>Sales Target</th>
                            <th>Closing Stock</th>
                            <th>Production Requirments</th>
                            <th>Budgeted Qty</th>                            
                        </tr>
                    </thead>

                    <tbody id="selectedtabledataprodbudget"></tbody>
                    <tfoot>
                        <tr>
                            <th colspan="7" class="text-end">Total</th>
                            <th id="bgdwqtyTotal">0</th>
                        </tr>
                    </tfoot>
                </table>
                <div class="d-flex justify-content-end gap-3 mt-2">
                    <button id="btnTotal" class="btn btn-primary btn-sm rounded-3">
                        Total
                    </button>

                    <button id="btnFinalUpdate" class="btn btn-outline-danger btn-sm rounded-3">
                        Final Update
                    </button>
                </div>
            </div>           
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/j_13_prodmon/jprodbudget.js" asp-append-version="true"></script>
}
