@{
    ViewData["Title"] = "Production Interface";
    var cards = new[]
    {
        //Item1=Card Div ID, Item2=Name of Card, Item3=Number Id of Card, Item4==completed ? "processed" : "pending"
        ("requestsDiv", "Requests", "reqQty", "requests"),
        ("reqApprovalDiv", "Requisitions", "reqApprQty", "requisitions"),
        ("materialIssueDiv", "Material Issues", "materialIssueQty", "issues"),
        ("issueAppDiv", "Issue Approved", "issueApprQty", "approvals"),
        ("matTransferedDiv", "In Process", "mattTransQty", "process"),
        ("ProEntryProdDiv", "Production Entry", "ProEntryProdIntQty", "production"),
        ("QcEntryDiv", "Quality Control", "QcProdIntQty", "qc"),
        ("FgReceiveProdDiv", "Floor Receive", "FgReceiveProdIntQty", "floorReceive"),
        ("WhReceiveProdDiv", "WH Receive", "WhReceiveProdIntQty", "warehouseReceive"),
        ("CompletedProdDiv", "Completed", "CompletedProdIntQty", "completed"),
        ("ReworkDiv", "Rework", "ReworkQty", "rework")
    };
}

<div class="interface-workspace">
    <div class="interface-toolbar">
        <div class="interface-filter-group" aria-label="Production date filter">
            <div class="interface-filter-field">
                <label for="txtfrmdate">From</label>
                <input id="txtfrmdate" type="text" class="form-control ui-size-xs datepicker datepicker-current" autocomplete="off" />
            </div>
            <div class="interface-filter-field">
                <label for="txttodate">To</label>
                <input id="txttodate" type="text" class="form-control ui-size-xs datepicker datepicker-current" autocomplete="off" />
            </div>
            <button id="btnOk" type="button" class="btn btn-primary ui-size-xs">
                <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                Load
            </button>
        </div>
        <div class="interface-toolbar-actions">
            <span class="interface-help-text">Select a workflow to view pending transactions</span>
            <button id="requisitionEntry" type="button" class="btn btn-success ui-size-xs">
                <i class="bi bi-plus-circle" aria-hidden="true"></i>
                New budget
            </button>
        </div>
    </div>

    <div class="interface-kpi-grid" id="interfacevalue" aria-label="Production workflow summary">
        @for (int index = 0; index < cards.Length; index++)
        {
            var card = cards[index];
            <button type="button"
                    class="interface-kpi-card @(index == 0 ? "active" : string.Empty)"
                    id="@card.Item1"
                    data-interface="@card.Item4"
                    aria-pressed="@(index == 0 ? "true" : "false")">
                <span class="interface-kpi-title">@card.Item2</span>
                <span class="interface-kpi-meta">
                    <span class="interface-kpi-dot" aria-hidden="true"></span>
                    @(card.Item4 == "completed" ? "Processed" : "Pending")
                </span>
                <strong class="interface-kpi-value" id="@card.Item3">0</strong>
            </button>
        }
    </div>

    <section class="interface-data-card" aria-label="Production workflow records">
        <div class="interface-table-region">
            <div id="tableContainerReq" class="table-responsive" style="display: none;">
                <table id="productionRequestTable" class="table table-hover align-middle mb-0 interface-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Budget Name</th>
                            <th>Date</th>
                            <th>Product Name</th>
                            <th>Item Count</th>
                            <th>Budgeted Qty</th>
                            <th>Budgeted Amount</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Current Status</th>
                            <th>WIP Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div id="tableContainerReqApp" class="table-responsive" style="display: none;">
                <table id="productionRequisitionTable" class="table table-hover align-middle mb-0 interface-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Budget Number</th>
                            <th>Date</th>
                            <th>Product Name</th>
                            <th>Item Count</th>
                            <th>Budgeted Qty</th>
                            <th>Budgeted Amount</th>
                            <th>Budget Balance</th>
                            <th>WIP Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div id="tableContainerMaterialissue" class="table-responsive" style="display: none;">
                <table id="productionIssueTable" class="table table-hover align-middle mb-0 interface-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Budget No</th>
                            <th>Req. No</th>
                            <th>Date</th>
                            <th>Batch No</th>
                            <th>Req. Qty</th>
                            <th>Item Count</th>
                            <th>Bal. Issue Item</th>
                            <th>Current Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div id="tableContainerIssueAppr" class="table-responsive" style="display: none;">
                <table id="productionIssueApprovalTable" class="table table-hover align-middle mb-0 interface-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Issue No</th>
                            <th>Issue Date</th>
                            <th>Req. No</th>
                            <th>Store Name</th>
                            <th>Batch</th>
                            <th>Req. Qty</th>
                            <th>Issue Qty</th>
                            <th>Mat. Issue Qty</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div id="tableContainermatTransfered" class="table-responsive" style="display: none;">
                <table id="productionProcessTable" class="table table-hover align-middle mb-0 interface-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Budget No</th>
                            <th>Req. No</th>
                            <th>Date</th>
                            <th>Batch No</th>
                            <th>Item Name</th>
                            <th>Item Count</th>
                            <th>Req. Qty</th>
                            <th>Bal. Item</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div id="tableContainerProentry" class="table-responsive" style="display: none;">
                <table id="productionEntryTable" class="table table-hover align-middle mb-0 interface-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Budget No</th>
                            <th>Date</th>
                            <th>Product Name</th>
                            <th>Batch Name</th>
                            <th>Item Count</th>
                            <th>Budget Qty</th>
                            <th>Prod. Bal Qty</th>
                            <th>Production Amount</th>
                            <th>Current Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div id="tableContainerQcEntry" class="table-responsive" style="display: none;">
                <table id="productionQcTable" class="table table-hover align-middle mb-0 interface-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Budget No</th>
                            <th>Production No</th>
                            <th>Date</th>
                            <th>Batch Name</th>
                            <th>Item Count</th>
                            <th>Production Qty</th>
                            <th>Production Amount</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div id="tableContainerFgReceive" class="table-responsive" style="display: none;">
                <table id="productionFloorReceiveTable" class="table table-hover align-middle mb-0 interface-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Receive No</th>
                            <th>Receive Date</th>
                            <th>QC Number</th>
                            <th>Batch Name</th>
                            <th>Item Count</th>
                            <th>Receive Qty</th>
                            <th>Receive Amount</th>
                            <th>Type</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div id="tableContainerWhReceive" class="table-responsive" style="display: none;">
                <table id="productionWarehouseReceiveTable" class="table table-hover align-middle mb-0 interface-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Receive No</th>
                            <th>Receive Date</th>
                            <th>QC Number</th>
                            <th>Batch Name</th>
                            <th>Item Count</th>
                            <th>Receive Qty</th>
                            <th>Receive Amount</th>
                            <th>Type</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div id="tableContainerCompletedProd" class="table-responsive" style="display: none;">
                <table id="productionCompletedTable" class="table table-hover align-middle mb-0 interface-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Budget No</th>
                            <th>Date</th>
                            <th>Item Count</th>
                            <th>Budgeted Qty</th>
                            <th>Budgeted Amount</th>
                            <th>Current Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div id="tableContainerRework" class="table-responsive" style="display: none;">
                <table id="productionReworkTable" class="table table-hover align-middle mb-0 interface-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Requisition No</th>
                            <th>Req. Date</th>
                            <th>Batch Name</th>
                            <th>Req. Qty</th>
                            <th>Rework Bal.</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/j_13_prodmon/jproductioninterface.js" asp-append-version="true"></script>
}
