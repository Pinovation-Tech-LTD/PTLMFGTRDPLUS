@{
    ViewData["Title"] = "Product Diagnosis";
}

@Html.AntiForgeryToken()

<div class="enterprise-entry-page service-diagnosis-page">
    <section class="card entry-header-card">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <div>
                    <h2 class="h6 mb-1">Service product context</h2>
                    <span id="modeBadge" class="badge text-bg-info">Diagnosis entry</span>
                </div>
                <div id="workflowActions" class="d-flex flex-wrap gap-2">
                    <button id="btnServiceDone" type="button" class="btn btn-outline-success ui-size-xs" hidden>
                        <i class="bi bi-check2-circle" aria-hidden="true"></i>
                        Service done
                    </button>
                    <button id="btnQcReject" type="button" class="btn btn-outline-danger ui-size-xs" hidden>
                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                        Refer back
                    </button>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-lg-4">
                    <div class="entry-field mb-2">
                        <label for="txtServiceCenter" class="form-label">Service center</label>
                        <input id="txtServiceCenter" class="form-control ui-size-xm" type="text" readonly />
                    </div>
                    <div class="entry-field mb-2">
                        <label for="txtSalesCenter" class="form-label">Sales center</label>
                        <input id="txtSalesCenter" class="form-control ui-size-xm" type="text" readonly />
                    </div>
                    <div class="entry-field mb-2">
                        <label for="txtDistributor" class="form-label">Distributor</label>
                        <input id="txtDistributor" class="form-control ui-size-xm" type="text" readonly />
                    </div>
                    <div class="entry-field mb-2">
                        <label for="txtDistributorAddress" class="form-label">Distributor address</label>
                        <textarea id="txtDistributorAddress" class="form-control" rows="2" readonly></textarea>
                    </div>
                    <div class="entry-field">
                        <label for="txtModel" class="form-label">Model</label>
                        <input id="txtModel" class="form-control ui-size-xm" type="text" readonly />
                    </div>
                </div>
                <div class="col-lg-4 border-lg-start border-lg-end">
                    <div class="entry-field mb-2">
                        <label for="txtImei" class="form-label">IMEI / serial number</label>
                        <input id="txtImei" class="form-control ui-size-xm" type="text" readonly />
                    </div>
                    <div class="entry-field mb-2">
                        <label for="txtCustomer" class="form-label">Customer name</label>
                        <input id="txtCustomer" class="form-control ui-size-xm" type="text" readonly />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6 entry-field">
                            <label for="txtMobile" class="form-label">Mobile number</label>
                            <input id="txtMobile" class="form-control ui-size-xm" type="text" readonly />
                        </div>
                        <div class="col-6 entry-field">
                            <label for="txtEmail" class="form-label">Email</label>
                            <input id="txtEmail" class="form-control ui-size-xm" type="text" readonly />
                        </div>
                    </div>
                    <div class="entry-field mb-2">
                        <label for="txtAddress" class="form-label">Customer address</label>
                        <input id="txtAddress" class="form-control ui-size-xm" type="text" readonly />
                    </div>
                    <div class="entry-field">
                        <label for="txtComplaint" class="form-label">Customer complaint</label>
                        <textarea id="txtComplaint" class="form-control" rows="2" readonly></textarea>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="row g-2 mb-2">
                        <div class="col-6 entry-field">
                            <label for="txtReceiveNo" class="form-label">Received ID</label>
                            <input id="txtReceiveNo" class="form-control ui-size-xm" type="text" readonly />
                        </div>
                        <div class="col-6 entry-field">
                            <label for="txtReceiveDate" class="form-label">Receive date</label>
                            <input id="txtReceiveDate" class="form-control ui-size-xm" type="text" readonly />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6 entry-field">
                            <label for="txtDiagnosisDate" class="form-label required">Diagnosis date</label>
                            <input id="txtDiagnosisDate" class="form-control ui-size-xm ui-datepicker-input" type="text" autocomplete="off" />
                        </div>
                        <div class="col-6 entry-field">
                            <label for="txtDeliveryDate" class="form-label">Probable delivery</label>
                            <input id="txtDeliveryDate" class="form-control ui-size-xm" type="text" readonly />
                        </div>
                    </div>
                    <div class="entry-field mb-2">
                        <label for="ddlWarranty" class="form-label required">Warranty status</label>
                        <select id="ddlWarranty" class="form-select ui-size-xm"></select>
                    </div>
                    <div id="replacementField" class="entry-field mb-2" hidden>
                        <label for="txtReplacementImei" class="form-label required">Replacement IMEI</label>
                        <input id="txtReplacementImei" class="form-control ui-size-xm" type="text" />
                    </div>
                    <div class="entry-field">
                        <label for="txtMissing" class="form-label">Missing item</label>
                        <input id="txtMissing" class="form-control ui-size-xm" type="text" readonly />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="row g-3">
        <div class="col-xl-5">
            <section class="card entry-panel h-100">
                <div class="card-header">
                    <h2 class="h6 mb-0">Problem diagnosis</h2>
                </div>
                <div class="card-body">
                    <div id="problemEntry" class="d-flex gap-2 align-items-end mb-2">
                        <div class="entry-field flex-grow-1">
                            <label for="ddlProblem" class="form-label">Problem</label>
                            <select id="ddlProblem" class="form-select ui-size-xs"></select>
                        </div>
                        <button id="btnAddProblem" class="btn btn-primary ui-size-xs" type="button" aria-label="Add problem">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="entry-native-table-shell">
                        <table id="diagnosisTable" class="table table-bordered enterprise-native-table">
                            <thead>
                                <tr>
                                    <th>Problem details</th>
                                    <th>Remarks</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <div class="entry-field mt-3">
                        <label for="txtPartsRemarks" class="form-label">Parts remarks</label>
                        <textarea id="txtPartsRemarks" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </section>
        </div>
        <div class="col-xl-7">
            <section class="card entry-panel h-100">
                <div class="card-header d-flex flex-wrap align-items-end justify-content-between gap-2">
                    <h2 class="h6 mb-0">Spare parts</h2>
                    <div id="partEntry" class="d-flex gap-2 align-items-end">
                        <div class="entry-field">
                            <label for="ddlSparePart" class="form-label">Part</label>
                            <select id="ddlSparePart" class="form-select ui-size-xs"></select>
                        </div>
                        <button id="btnAddPart" class="btn btn-primary ui-size-xs" type="button" aria-label="Add spare part">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="entry-native-table-shell border-0">
                        <table id="partsTable" class="table table-bordered enterprise-native-table mb-0">
                            <thead>
                                <tr>
                                    <th>Part description</th>
                                    <th>Unit</th>
                                    <th class="text-end">Stock</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Rate</th>
                                    <th class="text-end">Amount</th>
                                    <th>Approved</th>
                                    <th class="text-end">Issue qty.</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="5" class="text-end">Total</th>
                                    <th id="partsTotal" class="text-end">0.00</th>
                                    <th colspan="3"></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <section id="referencePanel" class="card entry-panel" hidden>
        <div class="card-header">
            <h2 class="h6 mb-0">Received details</h2>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-lg-6">
                    <h3 class="h6">Reported problems</h3>
                    <ul id="receivedProblems" class="mb-0"></ul>
                </div>
                <div class="col-lg-6">
                    <h3 class="h6">Received accessories</h3>
                    <ul id="receivedAccessories" class="mb-0"></ul>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/J_20_Service/jDiagProductEntry.js" asp-append-version="true"></script>
}
