@{
    var today = DateTime.Now.ToString("yyyy-MM-dd");
}

<div class="card  shadow-lg p-1 mb-1 bg-light">

    <div class="row g-3 p-1 align-items-end  rounded-4 shadow-sm">

        <div class="col-md-2">
            <label for="lbldate" class="form-label fw-semibold text-dark small mb-1">
                <i class="bi bi-calendar3 me-1 text-primary"></i>Date
            </label>
            <input id="txtdate" type="date"
                   class="form-control form-control-sm shadow-sm rounded-3"
                   value="@today" />
        </div>

        <div class="col-md-2">
            <label for="lblCurGetPassNo" class="form-label fw-semibold text-dark small mb-1">
                <i class="bi bi-receipt me-1 text-info"></i>Gate Pass No.
            </label>
            <input id="txtCurGetPasNo" type="text"
                   class="form-control form-control-sm shadow-sm rounded-3" />
        </div>

        <div class="col-md-2">
            <label for="lblgatepmanualno" class="form-label fw-semibold text-dark small mb-1">
                <i class="bi bi-journal-text me-1 text-warning"></i>Gate Pass (Manual)
            </label>
            <input id="txtGatemPassNo" type="text"
                   class="form-control form-control-sm shadow-sm rounded-3" />
        </div>

        <div class="col-md-1">
            <button id="btnOk"
                    class="btn btn-primary btn-sm rounded-pill shadow-sm w-100 py-2 fw-semibold">
                <i class="bi bi-check-lg me-1"></i> Ok
            </button>
        </div>

    </div>
    <div id="btnOkClick"
         class="row g-3 align-items-end mt-1 p-1 rounded-4 shadow-sm"
         style="display:flex;">

        <div class="col-md-3" id="RequisitionList">
            <label id="lblRequisitionList"
                   class="form-label fw-semibold text-primary small mb-2">
                <i class="bi bi-clock-history me-1"></i> Requisition List
            </label>
            <select id="txtRequisitionList"
                    class="form-select form-select-sm shadow-sm rounded-3">
                <option value="">Select Previous...</option>
            </select>
        </div>

        <div class="col-md-3">
            <label for="lblResList"
                   class="form-label fw-semibold text-dark small mb-2">
                <i class="bi bi-box-seam me-1 text-secondary"></i> Resources
            </label>
            <select id="ddlResourcelist"
                    class="form-select form-select-sm shadow-sm rounded-3">
                <option value="">Select Resource...</option>
            </select>
        </div>

        <div class="col-md-3">
            <label for="lblSpecification"
                   class="form-label fw-semibold text-dark small mb-2">
                <i class="bi bi-gear me-1 text-info"></i> Specification
            </label>
            <select id="ddlSpecification"
                    class="form-select form-select-sm shadow-sm rounded-3">
                <option value="">Select Spec...</option>
            </select>
        </div>

        <div class="col-md-3">
            <div class="d-flex gap-2">
                <button id="btnSelect"
                        class="btn btn-success btn-sm rounded-pill shadow-sm w-50 fw-semibold">
                    <i class="bi bi-plus-circle me-1"></i> Select
                </button>

                <button id="btnSelect"
                        class="btn btn-outline-success btn-sm rounded-pill shadow-sm w-50 fw-semibold">
                    <i class="bi bi-list-check me-1"></i> Select All
                </button>
            </div>
        </div>
    </div>

    <div class="row mt-2">
        <div id="tableContainer"
             class="table-responsive shadow-sm  rounded-4 overflow-hidden">

            <table class="table table-hover table-striped mb-0 align-middle"
                   style="table-layout:fixed; width:100%;">

                <thead class="table-primary text-center">
                    <tr>
                        <th>#</th>
                        <th>Transfer From</th>
                        <th>Transfer To</th>
                        <th>Description of Materials</th>
                        <th>Unit</th>
                        <th>Req. No.</th>
                        <th>MRF No.</th>
                        <th>Req. Qty</th>
                        <th>Bal. Qty</th>
                        <th>Stock Qty.</th>
                        <th>Approved Qty.</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody id="selectedtabledata">
                </tbody>

            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/j_07_rm/jPurMTReqGatePass.js" asp-append-version="true"></script>

    <style>
        .table thead th {
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
            vertical-align: middle;
        }

        .table tbody td {
            font-size: 13px;
            vertical-align: middle;
        }

        .form-control,
        .form-select {
            border: 1px solid #dee2e6;
        }

        .btn {
            transition: all 0.3s ease;
        }

            .btn:hover {
                transform: translateY(-1px);
            }

        .card {
            background: #f8f9fa;
        }
    </style>
}