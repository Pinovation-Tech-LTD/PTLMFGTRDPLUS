<link rel="stylesheet" href="~/css/common_design/production-dashboard.css" asp-append-version="true" />

<div class="container-fluid production-dashboard">

    <div class="pm-toolbar">
        <div class="pm-filter-group">
            <label for="txtfrmdate">From</label>
            <input id="txtfrmdate" type="text"
                   class="form-control form-control-sm datepicker datepicker-current" />

            <label for="txttodate">To</label>
            <input id="txttodate" type="text"
                   class="form-control form-control-sm datepicker datepicker-current" />

            <button id="btnOk" class="btn btn-primary btn-sm">
                Load Data
            </button>
        </div>

        <div class="pm-toolbar-actions">
            <button id="requisitionEntry" class="btn btn-success btn-sm">
                <i class="bi bi-plus-circle me-1"></i> New Requisition
            </button>
        </div>
    </div>

    <div class="pm-kpi-grid" id="interfacevalue">
        <div class="pm-kpi-card" id="requisitionDiv">
            <div class="pm-kpi-title">Requisition</div>
            <div class="pm-kpi-value text-primary" id="reqQty"></div>
            <div class="pm-kpi-bar bg-primary"></div>
        </div>

        <div class="pm-kpi-card" id="reqApprovalDiv">
            <div class="pm-kpi-title">Req. Approval</div>
            <div class="pm-kpi-value text-warning" id="reqApprQty"></div>
            <div class="pm-kpi-bar bg-warning"></div>
        </div>

        <div class="pm-kpi-card" id="storeIssueDiv">
            <div class="pm-kpi-title">Store Issue</div>
            <div class="pm-kpi-value text-info" id="storeIssueQty"></div>
            <div class="pm-kpi-bar bg-info"></div>
        </div>

        <div class="pm-kpi-card" id="storeReceiveDiv">
            <div class="pm-kpi-title">Store Receive</div>
            <div class="pm-kpi-value text-success" id="storeRecvQty"></div>
            <div class="pm-kpi-bar bg-success"></div>
        </div>

        <div class="pm-kpi-card" id="mattTransferedDiv">
            <div class="pm-kpi-title">Transferred</div>
            <div class="pm-kpi-value text-danger" id="mattTransQty"></div>
            <div class="pm-kpi-bar bg-danger"></div>
        </div>
    </div>

    <div class="pm-table-card table-section">
        <div id="tableContainerReq"
             class="table-responsive w-100"
             style="display:none;">

            <table class="table table-hover align-middle mb-0 text-nowrap pm-data-table"
                   style="min-width:1300px;">

                <thead>
                    <tr>
                        <th style="width:50px;">#</th>
                        <th style="width:140px;">Req. No</th>
                        <th style="width:120px;">Req. Date</th>
                        <th style="width:120px;">Matt. Ref</th>
                        <th style="width:240px;">Trans. From</th>
                        <th style="width:240px;">Trans. To</th>
                        <th style="width:200px;">Note</th>
                        <th style="width:100px;">Matt. Qty</th>
                        <th style="width:120px;">Total Amount</th>
                        <th style="width:100px;">Posted By</th>
                    </tr>
                </thead>

                <tbody id="selectedtabledataReq"></tbody>
            </table>
        </div>

        <div id="tableContainerReqApp"
             class="table-responsive w-100"
             style="display:none;">

            <table class="table table-hover align-middle mb-0 text-nowrap pm-data-table"
                   style="min-width:1370px;">

                <thead>
                    <tr>
                        <th style="width:50px;">#</th>
                        <th style="width:140px;">Req. No</th>
                        <th style="width:120px;">Req. Date</th>
                        <th style="width:120px;">Matt. Ref</th>
                        <th style="width:2100px;">Trans. From</th>
                        <th style="width:210px;">Trans. To</th>
                        <th style="width:150px;">Note</th>
                        <th style="width:90px;">Req. Qty</th>
                        <th style="width:110px;">Total Amount</th>
                        <th style="width:90px;">Posted By</th>
                        <th style="width:80px;"></th>
                    </tr>
                </thead>

                <tbody id="selectedtabledataReqApp"></tbody>
            </table>
        </div>

        <div id="tableContainerstoreissue"
             class="table-responsive w-100"
             style="display:none;">

            <table class="table table-hover align-middle mb-0 text-nowrap pm-data-table"
                   style="min-width:1450px;">

                <thead>
                    <tr>
                        <th style="width:50px;">#</th>
                        <th style="width:140px;">Req. No</th>
                        <th style="width:120px;">Req. Date</th>
                        <th style="width:120px;">Matt. Ref</th>
                        <th style="width:240px;">Trans. From</th>
                        <th style="width:240px;">Trans. To</th>
                        <th style="width:200px;">Note</th>
                        <th style="width:100px;">Req. Qty</th>
                        <th style="width:120px;">Req. Amount</th>
                        <th style="width:120px;">Gate Pass Bal</th>
                        <th style="width:100px;">Posted By</th>
                        <th style="width:100px;"></th>

                    </tr>
                </thead>

                <tbody id="selectedtabledatastoreissue"></tbody>
            </table>
        </div>

        <div id="tableContainerstorereceive"
             class="table-responsive w-100"
             style="display:none;">

            <table class="table table-hover align-middle mb-0 text-nowrap pm-data-table"
                   style="min-width:1500px;">

                <thead>
                    <tr>
                        <th style="width:50px;">#</th>
                        <th style="width:140px;">Req. No</th>
                        <th style="width:150px;">Get Pass. No</th>
                        <th style="width:120px;">Req. Date</th>
                        <th style="width:100px;">Matt. Ref</th>
                        <th style="width:240px;">Trans. From</th>
                        <th style="width:240px;">Trans. To</th>
                        <th style="width:180px;">Note</th>
                        <th style="width:100px;">Req. Qty</th>
                        <th style="width:120px;">Req. Amount</th>
                        <th style="width:120px;">Gate Pass Qty</th>
                        <th style="width:120px;">Transfer Bal</th>
                        <th style="width:100px;">Posted By</th>
                        <th style="width:120px;"></th>
                    </tr>
                </thead>

                <tbody id="selectedtabledatastorereceive"></tbody>
            </table>
        </div>

        <div id="tableContainermatttransfer"
             class="table-responsive w-100"
             style="display:none;">

            <table class="table table-hover align-middle mb-0 text-nowrap pm-data-table"
                   style="min-width:1600px;">

                <thead>
                    <tr>
                        <th style="width:50px;">#</th>
                        <th style="width:140px;">Req. No</th>
                        <th style="width:150px;">GPN. No</th>
                        <th style="width:150px;">TRN. No</th>
                        <th style="width:120px;">Req. Date</th>
                        <th style="width:100px;">Matt. Ref</th>
                        <th style="width:240px;">Trans. From</th>
                        <th style="width:240px;">Trans. To</th>
                        <th style="width:100px;">Note</th>
                        <th style="width:100px;">Req. Qty</th>
                        <th style="width:100px;">Req. Amount</th>
                        <th style="width:100px;">Transfer Qty</th>
                        <th style="width:100px;">Posted By</th>
                    </tr>
                </thead>

                <tbody id="selectedtabledatamatttransfer"></tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/j_07_rm/jsrawmattinterface.js" asp-append-version="true"></script>
    <script src="~/js/common/production-dashboard.js" asp-append-version="true"></script>
}
