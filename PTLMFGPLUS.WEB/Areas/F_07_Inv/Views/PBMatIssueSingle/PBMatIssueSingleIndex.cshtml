@{
    ViewData["Title"] = "Material Issue Information";
}
@section Styles {
    <link rel="stylesheet" href="~/css/common_design/pb-material-issue.css" asp-append-version="true" />
}

<div class="container-fluid pbmi-page" id="pbmiPage" data-lock-date="@ViewBag.LockIssueDate.ToString().ToLowerInvariant()">
    <div class="card shadow-sm mb-2">
        <div class="card-body py-2">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h5 class="mb-0"><i class="bi bi-box-arrow-right me-2"></i>Material Issue Information</h5><div>
              @*   <button id="btnSave" class="btn btn-success btn-sm">
                    <i class="bi bi-floppy me-1"></i>
                    <span>Save</span>
                </button>
                <button id="btnNew" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-plus-circle me-1"></i>New
                </button> *@
            </div>
        </div>
        <div class="row g-2 align-items-end">
            <div class="col-lg-2 col-md-3">
                <label class="form-label">Date</label>
                <input id="issueDate" class="form-control form-control-sm datepicker" autocomplete="off" />
            </div>
            <div class="col-lg-2 col-md-3">
                <label class="form-label">Ref. No.</label>
                <input id="referenceNo" class="form-control form-control-sm" />
            </div>
            <div class="col-lg-2 col-md-3">
                <label class="form-label">Issue No.</label>
                <input id="issueNo" class="form-control form-control-sm" readonly />
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Store</label>
                <select id="storeCode" class="form-select form-select-sm select2"></select>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="d-flex gap-2">
                    <button id="btnOpen" class="btn btn-primary btn-sm">
                        <i class="bi bi-check2 me-1">

                        </i>OK
                    </button><button id="btnPrevious" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-search me-1"></i>Previous List
                </button>
            </div>
        </div>
    </div>
    <div id="previousPanel" class="row g-2 mt-1 d-none">
        <div class="col-lg-4 col-md-6">
            <label class="form-label">Previous Issue</label><select id="previousIssue" class="form-select form-select-sm select2">
        </select>
    </div>
</div>
</div>
</div>

<div id="selectionPanel" class="card shadow-sm mb-2 d-none">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Req. Number</label>
                <select id="requisitionNo" class="form-select form-select-sm select2"></select>
            </div>
            <div class="col-lg-5 col-md-6">
                <label class="form-label">Material List</label>
                <select id="materialCode" class="form-select form-select-sm select2"></select>
            </div>
            <div class="col-lg-3">
                <button id="btnSelect" class="btn btn-primary btn-sm">Select</button>
                <button id="btnSelectAll" class="btn btn-primary btn-sm">Select All</button> <button id="btnToggleItems" class="btn btn-warning btn-sm">Item Expand</button>
            </div>
        </div>
    </div>
</div>

<div id="reqItemsPanel" class="card shadow-sm mb-2 d-none">
    <div class="card-body p-2">
        <div class="table-responsive">
            <table class="table table-sm table-bordered mb-0" id="reqItemsTable">
                <thead><tr><th>#</th><th>Description of Item</th><th>Unit</th><th class="text-end">Req Qty</th><th class="text-end">Issue Qty</th><th class="text-end">Issue Bal Qty</th></tr></thead>
                <tbody></tbody>
            </table>
        </div><button id="btnReload" class="btn btn-success btn-sm mt-2"><i class="bi bi-arrow-clockwise me-1"></i>Reload</button>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-2">
        <div class="table-responsive">
            <table class="table table-sm table-striped table-hover table-bordered mb-0" id="issueTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Req No</th>
                        <th>Batch Description</th>
                        <th>Process Description</th>
                        <th>Materials Description</th>
                        <th>Specification</th>
                        <th>Unit</th>
                        <th class="text-end">Stock Qty</th>
                        <th class="text-end">Req Qty</th>
                        <th class="text-end">Issue Bal Qty</th>
                        <th class="text-end">Issue Qty</th>
                        <th class="text-end">Issue Rate</th>
                        <th class="text-end">Bal Stock</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <div class="mt-2">
            <label class="form-label">Remarks</label>
            <textarea id="remarks" rows="2" class="form-control form-control-sm"></textarea>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <script src="~/js/J_07_Inv/jPBMatIssueSingle.js" asp-append-version="true"></script>
}
